{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "\"$FI_MOTOR/autonomo/bin/hook-arquivos.sh\"" }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "\"$FI_MOTOR/autonomo/bin/hook-bash.sh\"" }]
      }
    ]
  }
}
